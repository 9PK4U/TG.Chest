# Copy to .env. Secrets must not be committed. Values below are for VDS.
ENVIRONMENT=production
DEV_AUTH=false
DEV_USER_ID=1
ALLOWED_TELEGRAM_IDS=
PUBLIC_URL=https://chest.example.com
DOMAIN=chest.example.com
BOT_TOKEN=
# HTTP or SOCKS5 proxy on the VDS host; bot container uses host networking.
TELEGRAM_PROXY=
POSTGRES_PASSWORD=
DATABASE_URL=sqlite:///./chest.db
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=
DATA_DIR=data
STORAGE_BACKEND=local
YANDEX_DISK_TOKEN=
# For a scoped application token use app:/TG.Chest; full disk tokens can use disk:/TG.Chest
YANDEX_DISK_ROOT=app:/TG.Chest
OPENROUTER_API_KEY=
OPENROUTER_PROXY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Default answer model; can be replaced or cleared to disable answer generation.
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Optional, leave empty to use reciprocal rank fusion without reranking.
RERANK_MODEL=
# Independent OpenAI-compatible LOCAL/PRIVATE provider. No fallback to OpenRouter.
# Example from inside containers: http://host.docker.internal:11434/v1
TRUSTED_AI_BASE_URL=
TRUSTED_AI_API_KEY=
TRUSTED_AI_MODEL=
TRUSTED_AI_PROXY=
# Optional; must return EMBEDDING_DIMENSIONS=1536. Empty means local lexical search.
TRUSTED_EMBEDDING_MODEL=
MAX_FILE_MB=20
BACKUPS_ENABLED=false
BACKUP_RETENTION_DAYS=7
INIT_DATA_TTL=86400
